@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject GameCatalog Catalog
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject GameWeb.Accounts.AccountFeatures Accounts

<div class="site">
    <header class="site-header">
        <div class="wrap header-inner">
            <a class="brand" href="./">
                <span class="brand-tile" aria-hidden="true">麻</span>
                <span class="brand-name">@L["Jade Tables"]</span>
            </a>
            <nav class="site-nav" aria-label="@L["Main"]">
                <NavLink href="./" Match="NavLinkMatch.All" class="nav-home">@L["Home"]</NavLink>
                @foreach (var g in Catalog.Playable)
                {
                    <NavLink href="@g.Url" Match="NavLinkMatch.Prefix" class="nav-game">@L[g.NavName]</NavLink>
                }
                @* Phones: the pages go in one drop-down, so the header keeps fitting as games are added. *@
                <details class="nav-menu">
                    <summary aria-label="@L["Menu"]">
                        <span class="nav-menu-icon" aria-hidden="true">☰</span>
                        <span class="nav-menu-label">@L["Menu"]</span>
                    </summary>
                    <div class="nav-menu-list">
                        <NavLink href="./" Match="NavLinkMatch.All" class="nav-menu-item">@L["Home"]</NavLink>
                        @foreach (var g in Catalog.Playable)
                        {
                            <NavLink href="@g.Url" Match="NavLinkMatch.Prefix" class="nav-menu-item">@L[g.NavName]</NavLink>
                        }
                        <NavLink href="leaderboard" Match="NavLinkMatch.All" class="nav-menu-item">@L["Leaderboard"]</NavLink>
                    </div>
                </details>
                @if (Accounts.Enabled)
                {
                    if (HttpContext?.User.Identity?.IsAuthenticated == true)
                    {
                        <NavLink href="account" Match="NavLinkMatch.All" class="nav-account" title="@L["My games"]">@AccountName</NavLink>
                    }
                    else
                    {
                        <NavLink href="account/login" Match="NavLinkMatch.Prefix" class="nav-account">@L["Log in"]</NavLink>
                    }
                }
                <span class="lang-switch" role="group" aria-label="Language / 語言">
                    @foreach (var (culture, label, name) in Languages.Menu)
                    {
                        if (culture == Languages.CurrentCulture)
                        {
                            <span class="lang-opt is-current" lang="@culture" title="@name" aria-current="true">@label</span>
                        }
                        else
                        {
                            <a class="lang-opt" href="@SwitchHref(culture)" data-enhance-nav="false" hreflang="@culture" lang="@culture" title="@name" aria-label="@name">@label</a>
                        }
                    }
                </span>
                @* Phones: the same choice as a compact drop-down (plain HTML, works before the page is live). *@
                <details class="lang-menu">
                    <summary aria-label="Language / 語言">
                        @Languages.Menu.First(m => m.Culture == Languages.CurrentCulture).Short
                        <span class="lang-menu-caret" aria-hidden="true">▾</span>
                    </summary>
                    <div class="lang-menu-list" role="menu">
                        @foreach (var (culture, _, name) in Languages.Menu)
                        {
                            if (culture == Languages.CurrentCulture)
                            {
                                <span class="lang-menu-item is-current" lang="@culture" aria-current="true">@name</span>
                            }
                            else
                            {
                                <a class="lang-menu-item" role="menuitem" href="@SwitchHref(culture)" data-enhance-nav="false" hreflang="@culture" lang="@culture">@name</a>
                            }
                        }
                    </div>
                </details>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="wrap footer-inner">
            <span>@L["Jade Tables · Classic Chinese games with friends"]</span>
            <span>@L["Free to play. No sign-up, no real-money betting."] · <a href="privacy">@L["Privacy"]</a>
                @if (!string.IsNullOrWhiteSpace(Config["Analytics:GtmId"]))
                {
                    <text> · </text><button type="button" class="footer-link" data-consent-open>@L["Cookie settings"]</button>
                }
            </span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    @L["Something went wrong."]
    <a href="" class="reload">@L["Reload"]</a>
    <a class="dismiss">×</a>
</div>

@code {
    [CascadingParameter] HttpContext? HttpContext { get; set; }

    string AccountName => HttpContext?.User.FindFirst(GameWeb.Accounts.AccountSetup.DisplayNameClaim)?.Value is { Length: > 0 } name
        ? name : L["My games"];

    string SwitchHref(string culture) =>
        $"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}";
}
