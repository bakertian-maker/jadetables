@* A Xiangqi piece drawn as an SVG disc: the Chinese character, or a letter for beginners. *@
@inject XqText X

<svg class="xq-disc @(Piece > 0 ? "is-red" : "is-black")" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="21.5" r="18" class="xq-disc-edge" />
    <circle cx="20" cy="20" r="18" class="xq-disc-face" />
    <circle cx="20" cy="20" r="14.5" class="xq-disc-ring" />
    <g><text x="20" y="@(Letters ? 26.5 : 27)" class="@(Letters ? "xq-letter" : "xq-char")">@(Letters ? XqText.PieceLetter(Piece) : X.PieceChar(Piece))</text></g>
</svg>

@code {
    [Parameter] public int Piece { get; set; }
    /// <summary>Show a Latin letter (K, A, E, H, R, C, P) instead of the character.</summary>
    [Parameter] public bool Letters { get; set; }
}
