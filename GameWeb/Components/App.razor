@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // Google Tag Manager container (production only). Nothing loads until the visitor accepts.
    var gtmId = Config["Analytics:GtmId"];
    bool analytics = !string.IsNullOrWhiteSpace(gtmId);
}
<!DOCTYPE html>
<html lang="@Languages.HtmlLang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f3b31" />
    @* "/zh-cn/" or "/zh-hk/" for Chinese pages (see LanguagePaths): every link on the site is relative to it. *@
    <base href="@($"{HttpContext?.Request.PathBase}/")" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["mahjong.css"]" />
    <link rel="stylesheet" href="@Assets["xiangqi.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    @if (analytics)
    {
        <meta name="gtm-id" content="@gtmId" />
    }
    <LanguageLinks />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (analytics)
    {
        @* Shown by Scripts/consent.ts until the visitor chooses. *@
        <section id="consent-banner" class="consent" aria-label="@L["Cookie choices"]" hidden>
            <p>@L["May we use analytics cookies (Google Tag Manager) to see how the site is used? Nothing is sent to Google unless you accept."]
                <a href="privacy#analytics">@L["Privacy"]</a></p>
            <div class="consent-actions">
                <button type="button" class="btn btn-sm consent-btn" data-consent="denied">@L["Decline"]</button>
                <button type="button" class="btn btn-sm consent-btn" data-consent="granted">@L["Accept"]</button>
            </div>
        </section>
    }
    @* Blazor drives this element while the live connection is down (see Scripts/gameweb.ts). *@
    <dialog id="components-reconnect-modal" class="reconnect" data-state="retrying" aria-live="assertive" data-nosnippet>
        <div class="reconnect-inner">
            <span class="reconnect-spinner" aria-hidden="true"></span>
            <p class="reconnect-retrying">@L["Connection lost. Reconnecting…"]</p>
            <p class="reconnect-failed">@L["Can't reach the server. Check your connection."]</p>
            <button type="button" class="btn btn-primary btn-sm reconnect-failed" id="components-reconnect-button">@L["Try again"]</button>
            <p class="reconnect-reloading">@L["Reloading…"]</p>
        </div>
    </dialog>
    <script type="module" src="@Assets["js/gameweb.js"]"></script>
    <script type="module" src="@Assets["js/reconnect.js"]"></script>
    @if (analytics)
    {
        <script type="module" src="@Assets["js/consent.js"]"></script>
    }
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
}
