<!DOCTYPE html>
<html lang="@Languages.HtmlLang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f3b31" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;900&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["mahjong.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* Blazor drives this element while the live connection is down (see Scripts/gameweb.ts). *@
    <dialog id="components-reconnect-modal" class="reconnect" data-state="retrying" aria-live="assertive" data-nosnippet>
        <div class="reconnect-inner">
            <span class="reconnect-spinner" aria-hidden="true"></span>
            <p class="reconnect-retrying">@L["Connection lost. Reconnecting…"]</p>
            <p class="reconnect-failed">@L["Can't reach the server. Check your connection."]</p>
            <button type="button" class="btn btn-primary btn-sm reconnect-failed" id="components-reconnect-button">@L["Try again"]</button>
            <p class="reconnect-reloading">@L["Reloading…"]</p>
        </div>
    </dialog>
    <script type="module" src="@Assets["js/gameweb.js"]"></script>
    <script type="module" src="@Assets["js/reconnect.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
