@page "/account/reset-password"
@inherits AccountPageBase

<PageTitle>@L["Choose a new password · Jade Tables"]</PageTitle>

<div class="wrap page-pad auth-page">
    <h1>@L["Choose a new password"]</h1>
    @if (!Features.Enabled)
    {
        <AccountsUnavailable />
    }
    else
    {
        <div class="card auth-card">
            @if (done)
            {
                <p>@L["Your password has been changed."]</p>
                <a class="btn btn-primary" href="account/login">@L["Log in"]</a>
            }
            else
            {
                <EditForm Model="Input" FormName="reset" OnSubmit="Submit" class="auth-form" method="post">
                    <label>
                        @L["New password"]
                        <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" minlength="8" required />
                        <span class="auth-hint">@L["At least 8 characters."]</span>
                    </label>
                    <label>
                        @L["Repeat password"]
                        <InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                    </label>
                    @foreach (var e in Errors)
                    {
                        <p class="form-error">@e</p>
                    }
                    <button type="submit" class="btn btn-primary">@L["Save password"]</button>
                </EditForm>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromForm(FormName = "reset")] ResetInput Input { get; set; } = new();
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    bool done;

    async Task Submit()
    {
        if ((Input.Password ?? "") != (Input.ConfirmPassword ?? ""))
        {
            Errors.Add(L["The two passwords don't match."]);
            return;
        }
        var user = string.IsNullOrEmpty(UserId) ? null : await Users.FindByIdAsync(UserId);
        if (user is null || DecodeToken(Code) is not { } token)
        {
            Errors.Add(L["This link has expired or was already used. Please ask for a new one."]);
            return;
        }
        var result = await Users.ResetPasswordAsync(user, token, Input.Password ?? "");
        if (!result.Succeeded)
        {
            Errors.AddRange(result.Errors.Select(e => e.Description).Distinct());
            return;
        }
        // The link came to their inbox, so the address is theirs.
        if (!user.EmailConfirmed)
        {
            user.EmailConfirmed = true;
            await Users.UpdateAsync(user);
        }
        await Users.ResetAccessFailedCountAsync(user);
        done = true;
    }

    sealed class ResetInput
    {
        public string? Password { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}
