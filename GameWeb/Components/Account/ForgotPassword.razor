@page "/account/forgot-password"
@inherits AccountPageBase

<PageTitle>@L["Forgot your password? · Jade Tables"]</PageTitle>

<div class="wrap page-pad auth-page">
    <h1>@L["Forgot your password?"]</h1>
    @if (!Features.Enabled)
    {
        <AccountsUnavailable />
    }
    else
    {
        <div class="card auth-card">
            @if (sent)
            {
                <p>@L["If there is an account with that address, we've sent it a link to choose a new password."]</p>
                <a class="btn btn-ghost" href="account/login">@L["Back to log in"]</a>
            }
            else
            {
                <p>@L["Enter your email address and we'll send you a link to choose a new password."]</p>
                <EditForm Model="Input" FormName="forgot" OnSubmit="Submit" class="auth-form" method="post">
                    <label>
                        @L["Email"]
                        <InputText @bind-Value="Input.Email" type="email" autocomplete="email" required />
                    </label>
                    <button type="submit" class="btn btn-primary">@L["Send link"]</button>
                </EditForm>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromForm(FormName = "forgot")] EmailInput Input { get; set; } = new();

    bool sent;

    async Task Submit()
    {
        var email = (Input.Email ?? "").Trim();
        var user = email.Length > 0 ? await Users.FindByEmailAsync(email) : null;
        // Same answer whether or not the account exists. A Google-only account can use this to add a password.
        if (user is not null && Emails.TryReserve(user.Id))
        {
            var token = await Users.GeneratePasswordResetTokenAsync(user);
            var link = AbsoluteLink($"account/reset-password?userId={Uri.EscapeDataString(user.Id)}&code={EncodeToken(token)}");
            await Emails.SendPasswordResetAsync(user, link);
        }
        sent = true;
    }

    sealed class EmailInput
    {
        public string? Email { get; set; }
    }
}
