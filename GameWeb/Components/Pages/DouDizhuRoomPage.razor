@page "/doudizhu/room/{Code}"
@rendermode InteractiveServer
@implements IDisposable
@using GameWeb.Games.DouDizhu
@inject RoomService Rooms
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject GameWeb.Accounts.PlayerAccountLinker Links
@inject GameWeb.Accounts.AccountPrefs Prefs

<PageMeta Title="@L["Dou Dizhu room {0} · Jade Tables", Code.ToUpperInvariant()]" ShareTitle="@L["Join my Dou Dizhu game on Jade Tables"]" ShareDescription="@L["Room {0}: play Dou Dizhu (Fight the Landlord) with me in your browser. Free, no download or account needed.", Code.ToUpperInvariant()]" />

@if (state == PageState.Loading)
{
    <div class="wrap page-pad"><p class="mj-muted">@L["Joining room…"]</p></div>
}
else if (state == PageState.NotFound)
{
    <div class="wrap page-pad narrow">
        <h1>@L["Room not found"]</h1>
        <p>@L["Room {0} doesn't exist or has closed. Rooms close after 10 minutes with nobody in them.", Code.ToUpperInvariant()]</p>
        <a class="btn btn-primary" href="doudizhu">@L["Back to Dou Dizhu"]</a>
    </div>
}
else if (state == PageState.Full)
{
    <div class="wrap page-pad narrow">
        <h1>@L["This table is full"]</h1>
        <p>@L["All three seats in room {0} are taken.", Code.ToUpperInvariant()]</p>
        <a class="btn btn-primary" href="doudizhu">@L["Start your own room"]</a>
    </div>
}
else if (view is { Started: false })
{
    <WaitingRoom Code="@view.Code" Seats="view.LobbySeats" MySeat="view.MySeat" IsHost="view.IsHost" InviteUrl="@inviteUrl"
                 Lead="@L["Send the link to up to two friends. Empty seats are filled by computer players when the game starts."]"
                 OnAddBot="() => room!.AddBot(identity.Id)" OnRemove="i => room!.RemoveSeat(identity.Id, i)" OnStart="() => room!.Start(identity.Id)">
        <SeatBadge Context="i">
            <span class="seat-wind">@(i + 1)</span>
        </SeatBadge>
        <Summary>
            @L["{0} hands", view.Settings.Hands] ·
            @(view.Settings.TurnSeconds == 0 ? L["no turn timer"] : L["{0}s per turn", view.Settings.TurnSeconds])
        </Summary>
    </WaitingRoom>
}
else if (view is not null)
{
    <DouDizhuTable View="view" OnAction="Act" OnPlayAgain="PlayAgain" SoundOn="soundOn" OnToggleSound="ToggleSound" />
}

@code {
    enum PageState { Loading, NotFound, Full, Ready }

    public sealed record Identity(string Id, string Name);

    [Parameter] public string Code { get; set; } = "";

    PageState state = PageState.Loading;
    DdzRoom? room;
    DdzView? view;
    Identity identity = new("", "");
    string inviteUrl = "";
    bool connected;
    volatile bool disposed;
    readonly ViewerCulture culture = ViewerCulture.Capture();
    bool soundOn = true;
    bool needsMe;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        room = Rooms.Get(Code) as DdzRoom;
        if (room is null)
        {
            state = PageState.NotFound;
            StateHasChanged();
            return;
        }
        identity = await JS.InvokeAsync<Identity>("gameweb.identity", L["Guest"].Value);
        // Signed in: play under the account's name, and games played in this browser belong to the account.
        if (await Links.CurrentAsync() is { DisplayName.Length: > 0 } me) identity = identity with { Name = me.DisplayName };
        _ = Links.LinkCurrentAsync(identity.Id);
        inviteUrl = Nav.BaseUri + room.Url;

        room.Changed += OnRoomChanged;
        var outcome = room.Connect(identity.Id, identity.Name);
        connected = outcome is JoinOutcome.Seated or JoinOutcome.Rejoined;
        state = outcome == JoinOutcome.Full ? PageState.Full : PageState.Ready;
        view = room.GetView(identity.Id);
        soundOn = await JS.InvokeAsync<bool>("gameweb.soundEnabled");
        if (await Links.CurrentAsync() is { } account && await Prefs.PrefsAsync(account.UserId) is { } prefs)
        {
            soundOn = prefs.SoundOn;
            await JS.InvokeVoidAsync("gameweb.syncPrefs", soundOn, null);
        }
        StateHasChanged();
    }

    /// <summary>Tells the browser when it is this player's turn, so a background tab can alert them.</summary>
    async Task UpdateAttention()
    {
        bool now = view is { Started: true, MyTurn: true };
        if (now == needsMe) return;
        needsMe = now;
        try
        {
            await JS.InvokeVoidAsync("gameweb.attention", now, L["Your turn"].Value);
        }
        catch (JSDisconnectedException)
        {
            // The browser has gone; nothing to alert.
        }
    }

    async Task ToggleSound()
    {
        soundOn = !soundOn;
        await JS.InvokeVoidAsync("gameweb.setSound", soundOn);
        if (await Links.CurrentAsync() is { } me) await Prefs.SavePrefsAsync(me.UserId, soundOn: soundOn);
    }

    void OnRoomChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (room is null || disposed) return Task.CompletedTask;
            culture.Apply();
            view = room.GetView(identity.Id);
            StateHasChanged();
            return UpdateAttention();
        });
    }

    void Act(DdzAction action) => room?.Act(identity.Id, action);

    void PlayAgain() => room?.PlayAgain(identity.Id);

    public void Dispose()
    {
        disposed = true;
        if (room is null) return;
        room.Changed -= OnRoomChanged;
        if (connected) room.Disconnect(identity.Id);
    }
}
