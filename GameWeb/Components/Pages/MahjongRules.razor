@page "/mahjong/rules"

<PageTitle>@L["Hong Kong Mahjong rules · Jade Tables"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["Hong Kong mahjong rules as played on Jade Tables: tiles, claiming, winning hands and the faan scoring table."]" />
</HeadContent>

