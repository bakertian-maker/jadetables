@page "/"
@inject GameCatalog Catalog

<PageMeta Title="@L["Free Classic Chinese Games Online: Mahjong, Xiangqi & Dou Dizhu | Jade Tables"]" Description="@L["Play Hong Kong mahjong, Xiangqi (Chinese chess) and Dou Dizhu free in your browser: no download, no account needed. Invite friends with a link or play the computer."]" />

<section class="hero">
    <div class="wrap hero-inner">
        <div class="hero-copy">
            <p class="eyebrow">@L["Mahjong · Xiangqi · Dou Dizhu"]</p>
            <h1>@L["Free classic Chinese games: no download, no account, multiplayer."]</h1>
            <p class="lead">@L["Open a private room, send the link to friends and play on any phone or laptop. Short a player? A computer player takes the empty seat."]</p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" href="mahjong">@L["Play Mahjong"]</a>
                <a class="btn btn-primary btn-lg" href="xiangqi">@L["Play Xiangqi"]</a>
                <a class="btn btn-primary btn-lg" href="doudizhu">@L["Play Dou Dizhu"]</a>
            </div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="hero-fan">
                <MjTile Kind="0" Size="lg" />
                <MjTile Kind="10" Size="lg" />
                <MjTile Kind="20" Size="lg" />
                <MjTile Kind="Tiles.East" Size="lg" />
                <MjTile Kind="Tiles.Red" Size="lg" />
            </div>
        </div>
    </div>
</section>

<section class="wrap page-pad">
    <ContinueGames @rendermode="InteractiveServer" />
    <h2 class="section-title">@L["Games"]</h2>
    <div class="game-grid">
        @foreach (var g in Catalog.Games)
        {
            var playable = g.Status == GameStatus.Playable;
            <article class="game-card @(playable ? "" : "is-soon")">
                <div class="game-card-head">
                    <span class="game-zh">@(Languages.Current == Script.Simplified ? g.SimplifiedName : g.ChineseName)</span>
                    @if (!playable)
                    {
                        <span class="mj-tag">@L["In development"]</span>
                    }
                </div>
                <h3>@L[g.Name]</h3>
                <p class="game-tagline">@L[g.Tagline]</p>
                <p>@L[g.Description]</p>
                <div class="game-card-foot">
                    <span class="mj-muted">@L[g.Players]</span>
                    @if (playable)
                    {
                        <a class="btn btn-primary" href="@g.Url">@L["Play"]</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="wrap page-pad home-screen-wrap">
    <div class="home-screen-tip" id="home-screen">
        <img src="icon-192.png" alt="" width="56" height="56" />
        <div>
            <h2>@L["Play in one tap: add Jade Tables to your Home Screen"]</h2>
            <p>@L["Open the exact page you want to save, such as this one or your favourite game, then add it to your phone's Home Screen."]</p>
            <ul>
                <li>
                    <strong>@L["iPhone (Safari):"]</strong>
                    @L["Tap Share (it may be under ⋯) → Add to Home Screen → Add. If you see Open as Web App, leave it off for a regular browser shortcut."]
                    <a href="@AppleHelp" target="_blank" rel="noopener">@L["Apple's instructions"]</a>
                </li>
                <li>
                    <strong>@L["Android (Chrome):"]</strong>
                    @L["Tap ⋮ → Install and create shortcut → Create shortcut → Add. Some versions call the menu option Add to Home screen."]
                    <a href="@GoogleHelp" target="_blank" rel="noopener">@L["Google's instructions"]</a>
                </li>
            </ul>
            <p class="mj-muted">@L["You can rename the shortcut before tapping Add."]</p>
        </div>
    </div>
</section>

<section class="wrap page-pad features">
    <div class="feature">
        <h3>@L["Private rooms"]</h3>
        <p>@L["Every room gets a short code and a link. Anyone with the link can sit down."]</p>
    </div>
    <div class="feature">
        <h3>@L["Computer players"]</h3>
        <p>@L["Practise alone, or fill empty seats. If someone drops out, a computer player keeps their seat warm for them."]</p>
    </div>
    <div class="feature">
        <h3>@L["Made for beginners too"]</h3>
        <p>@L["Tile numbers in the corner, a hint button and plain-English rules with the Chinese names alongside."]</p>
    </div>
</section>

@code {
    // Each help page in the visitor's language.
    static string AppleHelp => Languages.Current switch
    {
        Script.Simplified => "https://support.apple.com/zh-cn/guide/iphone/iph42ab2f3a7/ios",
        Script.Traditional => "https://support.apple.com/zh-hk/guide/iphone/iph42ab2f3a7/ios",
        _ => "https://support.apple.com/en-asia/guide/iphone/iph42ab2f3a7/ios",
    };

    static string GoogleHelp => "https://support.google.com/chrome/answer/15085120?co=GENIE.Platform%3DAndroid&hl=" + Languages.Current switch
    {
        Script.Simplified => "zh-Hans",
        Script.Traditional => "zh-Hant",
        _ => "en-GB",
    };
}
