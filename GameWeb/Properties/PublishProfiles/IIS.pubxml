<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes a framework-dependent build for IIS into GameWeb\bin\publish\iis.
     Usage: dotnet publish GameWeb -p:PublishProfile=IIS   (see DEPLOY.md) -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishUrl>bin\publish\iis\</PublishUrl>
    <PublishDir>bin\publish\iis\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>
</Project>
